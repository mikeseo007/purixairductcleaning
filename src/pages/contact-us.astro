---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Reviews from '../components/Reviews.astro';
import Icon from '../components/Icon.astro';
import GoogleMap from '../components/GoogleMap.astro';
import { site, locations } from '../data/site';
import { businessId } from '../data/schema';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact Us', path: '/contact-us/' },
];
---

<BaseLayout
  title="Contact Purix | Air Duct & HVAC Cleaning in Miami, FL"
  description="Contact Purix Air Duct & Dryer Vent Cleaning in Miami. Call (305) 449-9881 or request a free quote. Open 24 hours Sunday through Friday."
  breadcrumbs={breadcrumbs}
  schema={[{ '@type': 'ContactPage', name: `Contact ${site.name}`, url: `${site.url}/contact-us/`, about: { '@id': businessId } }]}
>
  <PageHeader
    eyebrow="Contact us"
    title="Book an Inspection or Get a Free Quote"
    subtitle="Call us or send a service request for air duct, AC ductwork, HVAC or dryer vent cleaning, and we’ll get back to you to schedule."
    breadcrumbs={breadcrumbs}
  />

  <section class="section bg-sky-50">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="text-3xl sm:text-4xl">{site.name}</h2>
        <p class="mt-3 text-lg text-muted">Based in Miami, serving Miami-Dade and communities across South and Southwest Florida.</p>

        <ul class="mt-8 grid gap-5 sm:grid-cols-2">
          <li class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
            <p class="flex items-center gap-2 text-sm font-semibold text-muted"><Icon name="phone" class="size-4" /> Phone</p>
            <a href={site.phoneHref} class="mt-2 block text-2xl font-extrabold text-navy-700 hover:text-sky-500">{site.phone}</a>
          </li>
          <li class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
            <p class="flex items-center gap-2 text-sm font-semibold text-muted"><Icon name="clock" class="size-4" /> Hours</p>
            <p class="mt-2 font-bold text-navy-900">Sunday – Friday: Open 24 hours</p>
            <p class="font-bold text-navy-900">Saturday: Closed</p>
          </li>
          <li class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
            <p class="flex items-center gap-2 text-sm font-semibold text-muted"><Icon name="pin" class="size-4" /> Address</p>
            <address class="mt-2 font-bold text-navy-900 not-italic">
              {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}
            </address>
            <a href={site.mapsUrl} target="_blank" rel="noopener" class="mt-1 inline-block text-sm font-semibold text-sky-500 hover:underline">Get directions</a>
          </li>
          <li class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
            <p class="flex items-center gap-2 text-sm font-semibold text-muted"><Icon name="mail" class="size-4" /> Email</p>
            <a href={`mailto:${site.email}`} class="mt-2 block font-bold break-all text-navy-900 hover:text-sky-500">{site.email}</a>
          </li>
        </ul>

        <div class="mt-8">
          <GoogleMap class="h-[400px]" />
        </div>

        <p class="mt-8 font-bold text-navy-900">Areas we serve</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            locations.map((l) => (
              <li>
                <a href={l.path} class="inline-block rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold text-navy-800 ring-1 ring-sky-100 hover:bg-sky-100">
                  {l.city}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <QuoteForm heading="Send a Service Request" />
        </div>
      </div>
    </div>
  </section>

  <Reviews />
</BaseLayout>
