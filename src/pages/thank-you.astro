---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<BaseLayout title="Thank You" description={`Thanks for contacting ${site.name}. We'll be in touch shortly.`} noindex>
  <section class="section bg-sky-50">
    <div class="container-x max-w-3xl text-center">
      <span class="mx-auto flex size-20 items-center justify-center rounded-full bg-lime-500 text-navy-950 shadow-lg shadow-lime-500/30">
        <Icon name="check" class="size-10" />
      </span>
      <h1 class="mt-8 text-4xl sm:text-5xl">Thank you! We got your request.</h1>
      <p class="mt-5 text-lg text-muted">A member of our team will contact you to confirm the details. Need help right away? Give us a call.</p>
      <a href={site.phoneHref} class="btn-primary mt-8 !px-8 !py-4 text-lg">
        <Icon name="phone" class="size-5" />
        {site.phone}
      </a>
      <p class="mt-4 text-sm text-muted">{site.hours.long}</p>
      <a href="/" class="btn-navy mt-10">Back to home</a>
    </div>
  </section>
</BaseLayout>
