---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { locations } from '../data/site';
---

<BaseLayout title="Thank You" description="Thanks for contacting Purix Air Duct Cleaning. We'll be in touch shortly." noindex>
  <section class="section bg-sky-50">
    <div class="container-x max-w-3xl text-center">
      <span class="mx-auto flex size-20 items-center justify-center rounded-full bg-lime-500 text-navy-950 shadow-lg shadow-lime-500/30">
        <Icon name="check" class="size-10" />
      </span>
      <h1 class="mt-8 text-4xl sm:text-5xl">Thank you! We got your request.</h1>
      <p class="mt-5 text-lg text-muted">A member of our team will contact you shortly to confirm the details. Need help right away? Call the office nearest you.</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          locations.map((loc) => (
            <a href={loc.phoneHref} class="flex items-center justify-between rounded-2xl bg-white p-5 text-left shadow-sm ring-1 ring-slate-100 hover:ring-sky-300">
              <span class="font-bold text-navy-900">{loc.city}</span>
              <span class="flex items-center gap-2 font-bold text-navy-700">
                <Icon name="phone" class="size-4" />
                {loc.phone}
              </span>
            </a>
          ))
        }
      </div>
      <a href="/" class="btn-navy mt-10">Back to home</a>
    </div>
  </section>
</BaseLayout>
