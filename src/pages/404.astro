---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import { locations } from '../data/site';
---

<BaseLayout title="Page Not Found" description="The page you were looking for could not be found." noindex>
  <section class="relative isolate overflow-hidden bg-navy-950 pt-20 pb-28 text-white lg:pt-28 lg:pb-36">
    <div class="drift pointer-events-none absolute inset-x-0 -top-40 -z-10 mx-auto size-[36rem] rounded-full bg-sky-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="container-x max-w-3xl text-center">
      <p class="rise text-gradient font-display text-[7rem] leading-none font-bold sm:text-[9rem]">404</p>
      <h1 class="rise mt-4 text-4xl text-white sm:text-5xl" style="--d: 1">This page took a wrong turn in the ductwork</h1>
      <p class="rise mt-5 text-lg text-sky-100/80" style="--d: 2">The page you’re looking for doesn’t exist or has moved. Try one of these instead:</p>
      <a href="/" class="btn-primary rise mt-9" style="--d: 3">
        Back to home <Icon name="arrowRight" class="size-4" />
      </a>
    </div>
  </section>

  <section class="section relative overflow-hidden bg-surface">
    <div class="container-x relative grid max-w-5xl gap-8 sm:grid-cols-2">
      <div class="card p-8" data-reveal="left">
        <h2 class="text-2xl">Services</h2>
        <ul class="mt-5 space-y-2.5">
          {
            services.map((s) => (
              <li>
                <a href={s.path} class="group inline-flex items-center gap-2 font-semibold text-navy-700 hover:text-navy-900">
                  <Icon name="arrowRight" class="size-3.5 text-sky-500 transition group-hover:translate-x-0.5" />
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card p-8" data-reveal="right">
        <h2 class="text-2xl">Locations</h2>
        <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2.5">
          {
            locations.map((l) => (
              <li>
                <a href={l.path} class="group inline-flex items-center gap-2 font-semibold text-navy-700 hover:text-navy-900">
                  <Icon name="arrowRight" class="size-3.5 text-sky-500 transition group-hover:translate-x-0.5" />
                  {l.city}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
