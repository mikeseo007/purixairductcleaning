---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { locations } from '../data/site';
---

<BaseLayout title="Page Not Found" description="The page you were looking for could not be found." noindex>
  <section class="section bg-sky-50">
    <div class="container-x max-w-3xl text-center">
      <p class="text-7xl font-extrabold text-sky-400">404</p>
      <h1 class="mt-4 text-4xl sm:text-5xl">This page took a wrong turn in the ductwork</h1>
      <p class="mt-5 text-lg text-muted">The page you’re looking for doesn’t exist or has moved. Try one of these instead:</p>
      <div class="mt-10 grid gap-8 text-left sm:grid-cols-2">
        <div>
          <h2 class="text-lg">Services</h2>
          <ul class="mt-3 space-y-2">
            {services.map((s) => <li><a href={s.path} class="font-semibold text-navy-700 hover:text-sky-500">{s.name}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="text-lg">Locations</h2>
          <ul class="mt-3 space-y-2">
            {locations.map((l) => <li><a href={l.path} class="font-semibold text-navy-700 hover:text-sky-500">{l.city}</a></li>)}
          </ul>
        </div>
      </div>
      <a href="/" class="btn-navy mt-10">Back to home</a>
    </div>
  </section>
</BaseLayout>
