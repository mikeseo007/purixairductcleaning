---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SplitSection from '../components/SplitSection.astro';
import TrustBar from '../components/TrustBar.astro';
import ServicesSection from '../components/ServicesSection.astro';
import Reviews from '../components/Reviews.astro';
import LocationsGrid from '../components/LocationsGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import technicianAttic from '../assets/images/technician-cleaning-attic-duct.jpg';
import technicians from '../assets/images/technicians-living-room-duct-cleaning.png';
import { site } from '../data/site';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'About Us', path: '/about-us/' },
];

const values = [
  { icon: 'search', title: 'Honest inspections', text: 'We explain what we find before we start, and we recommend only the services your system actually needs.' },
  { icon: 'shield', title: 'Careful, clean work', text: 'Floors and work areas are protected, and loosened debris goes into our collection equipment.' },
  { icon: 'users', title: 'Walkthrough after every job', text: 'We show you the results and point out anything that may need attention later.' },
  { icon: 'clock', title: 'Open 24 hours, Sun–Fri', text: 'Call any time Sunday through Friday to book an inspection or get a quote.' },
];
---

<BaseLayout
  title="About Purix | Miami Air Duct & HVAC Cleaning Company"
  description="Purix Air Duct & Dryer Vent Cleaning is a Miami company focused on air duct, AC ductwork and HVAC cleaning for homes and businesses. Call (305) 449-9881."
  breadcrumbs={breadcrumbs}
>
  <PageHeader
    eyebrow="About us"
    title="Miami’s Air Duct & HVAC Cleaning Team"
    subtitle={`${site.name} helps homeowners and businesses keep their AC ductwork and HVAC equipment clean.`}
    breadcrumbs={breadcrumbs}
  />
  <TrustBar />

  <SplitSection
    eyebrow="Who we are"
    heading="Focused on the air side of your AC system"
    image={technicianAttic}
    imageAlt="Purix technician working on flexible AC ductwork through a ceiling opening"
    paragraphs={[
      'Purix is based in Miami and serves homes and businesses across South Florida, with service in Miami-Dade, Fort Lauderdale, Boca Raton, Naples and Cape Coral. Our main focus is air conditioning systems: air duct and AC ductwork cleaning, duct inspection and replacement, and cleaning for the coils, air handlers and blower wheels inside the equipment.',
      'We also help homeowners deal with musty AC odors and suspected microbial buildup on HVAC components, and we offer dryer vent cleaning and installation for homes and commercial laundry.',
    ]}
  />

  <SplitSection
    eyebrow="How we approach each job"
    heading="Clear scope, careful work, honest results"
    image={technicians}
    imageAlt="Purix technicians preparing equipment for an air duct cleaning"
    reverse
    tint
    paragraphs={[
      'Every system is different. A Miami condo with a closet air handler needs a different approach than a single-family home with long attic duct runs. We look at your system first, explain what we see, and agree on the scope before any work begins.',
      'We’re straightforward about what cleaning can and can’t do. It removes buildup from your ducts and equipment. It doesn’t replace repairs, and it isn’t a medical treatment. If we see damaged ductwork or a moisture problem, we’ll tell you.',
    ]}
  />

  <section class="section bg-white">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">How we work</p>
        <h2 class="text-3xl sm:text-4xl">What You Can Expect From Purix</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v) => (
            <div class="rounded-3xl border border-slate-100 bg-white p-7 shadow-sm">
              <span class="flex size-12 items-center justify-center rounded-2xl bg-sky-100 text-navy-700">
                <Icon name={v.icon} class="size-6" />
              </span>
              <h3 class="mt-5 text-lg">{v.title}</h3>
              <p class="mt-2 text-muted">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ServicesSection bg="sky" />
  <Reviews />
  <LocationsGrid tint />

  <section class="section bg-navy-950">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow !text-lime-500">Get in touch</p>
        <h2 class="text-3xl !text-white sm:text-4xl">Schedule Your Cleaning</h2>
        <p class="mt-4 text-lg text-white/80">Send us a request and we’ll call you back to confirm the details and give you a free quote.</p>
      </div>
      <QuoteForm />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
