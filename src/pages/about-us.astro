---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SplitSection from '../components/SplitSection.astro';
import TrustBar from '../components/TrustBar.astro';
import ServicesSection from '../components/ServicesSection.astro';
import Reviews from '../components/Reviews.astro';
import LocationsSection from '../components/LocationsSection.astro';
import CtaBand from '../components/CtaBand.astro';
import QuoteSection from '../components/QuoteSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { photos } from '../data/photos';
import { site } from '../data/site';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'About Us', path: '/about-us/' },
];

const values = [
  { icon: 'search', title: 'Honest inspections', text: 'We explain what we find before we start, and we recommend only the services your system actually needs.' },
  { icon: 'shield', title: 'Careful, clean work', text: 'Floors and work areas are protected, and loosened debris goes into our collection equipment.' },
  { icon: 'users', title: 'Walkthrough after every job', text: 'We show you the results and point out anything that may need attention later.' },
  { icon: 'clock', title: 'Open 24/7', text: 'Call any time, day or night, to book an inspection or get a quote.' },
];
---

<BaseLayout
  title="About Purix | Miami Air Duct & Dryer Vent Cleaning Company"
  description="Purix Air Duct & Dryer Vent Cleaning is a Miami company focused on air duct, AC ductwork and HVAC cleaning for homes and businesses. Call (305) 449-9881."
  breadcrumbs={breadcrumbs}
>
  <PageHeader
    eyebrow="About us"
    title="Miami’s Air Duct & Dryer Vent Cleaning Team"
    subtitle={`${site.name} helps homeowners and businesses keep their AC ductwork and HVAC equipment clean.`}
    breadcrumbs={breadcrumbs}
    overlap
  />
  <TrustBar />

  <SplitSection
    eyebrow="Who we are"
    heading="Focused on the air side of your AC system"
    image={photos.teamWithVan.src}
    imageAlt={photos.teamWithVan.alt}
    paragraphs={[
      'Purix is based in Miami and serves homes and businesses across South Florida, with service throughout Miami-Dade and Broward counties and in Boca Raton, Naples and Cape Coral. Our main focus is air conditioning systems: air duct and AC ductwork cleaning, duct inspection and replacement, and cleaning for the coils, air handlers and blower wheels inside the equipment.',
      'We also help homeowners deal with musty AC odors and suspected microbial buildup on HVAC components, and we offer dryer vent cleaning and installation as well as attic insulation removal, blown-in insulation and insulation replacement.',
    ]}
  />

  <SplitSection
    eyebrow="How we approach each job"
    heading="Clear scope, careful work, honest results"
    image={photos.vanDuctCrew.src}
    imageAlt={photos.vanDuctCrew.alt}
    reverse
    tint
    paragraphs={[
      'Every system is different. A Miami condo with a closet air handler needs a different approach than a single-family home with long attic duct runs. We look at your system first, explain what we see, and agree on the scope before any work begins.',
      'We’re straightforward about what cleaning can and can’t do. It removes buildup from your ducts and equipment. It doesn’t replace repairs, and it isn’t a medical treatment. If we see damaged ductwork or a moisture problem, we’ll tell you.',
    ]}
  />

  <section class="section bg-white">
    <div class="container-x">
      <SectionHeading eyebrow="How we work" title="What You Can Expect From Purix" center />
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {
          values.map((v, i) => (
            <div class="card card-hover spotlight p-7">
              <div class="flex items-center justify-between">
                <span class="icon-chip size-12"><Icon name={v.icon} class="size-6" /></span>
                <span class="font-display text-4xl font-bold text-sky-100">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="mt-6 text-xl">{v.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ServicesSection bg="sky" avoid={[photos.teamWithVan.src, photos.vanDuctCrew.src]} />
  <Reviews />
  <LocationsSection tint />

  <QuoteSection
    eyebrow="Get in touch"
    title="Schedule Your Cleaning"
    text="Send us a request and we’ll call you back to confirm the details and give you a free quote."
  />

  <CtaBand />
</BaseLayout>
