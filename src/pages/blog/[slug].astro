---
import { Image, getImage } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { articleSchema } from '../../data/schema';
import { services } from '../../data/services';
import { SITE_URL, site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}/`;
const og = await getImage({ src: post.data.cover, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, SITE_URL).toString();
const service = services.find((s) => s.slug === post.data.service);

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.data.title, path },
];
const fmt = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={og.src}
  ogType="article"
  breadcrumbs={breadcrumbs}
  schema={[
    articleSchema({
      title: post.data.title,
      description: post.data.description,
      path,
      datePublished: post.data.date.toISOString(),
      image: ogUrl,
    }),
  ]}
>
  <PageHeader title={post.data.title} subtitle={post.data.description} breadcrumbs={breadcrumbs} />

  <section class="section bg-white">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <article class="lg:col-span-8">
        <p class="mb-6 flex items-center gap-2 text-sm font-semibold text-muted">
          <Icon name="clock" class="size-4 text-sky-500" />
          <time datetime={post.data.date.toISOString()}>{fmt}</time>
          <span class="text-slate-300">•</span>
          {site.name}
        </p>
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt}
          widths={[640, 960]}
          sizes="(min-width: 1024px) 800px, 100vw"
          loading="eager"
          class="mb-10 aspect-[19/10] w-full rounded-3xl object-cover shadow-lg"
        />
        <div class="prose-purix">
          <Content />
        </div>
      </article>

      <aside class="lg:col-span-4">
        <div class="space-y-6 lg:sticky lg:top-28">
          {
            service && (
              <a href={service.path} class="group block rounded-3xl bg-sky-50 p-6 ring-1 ring-sky-100 transition hover:ring-sky-300">
                <p class="text-sm font-bold tracking-wider text-sky-500 uppercase">Related service</p>
                <p class="mt-2 text-xl font-extrabold text-navy-900 group-hover:text-sky-500">{service.name}</p>
                <p class="mt-2 text-muted">{service.card}</p>
              </a>
            )
          }
          <QuoteForm heading="Get a Free Quote" compact />
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
