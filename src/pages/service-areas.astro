---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ServicesSection from '../components/ServicesSection.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { locations, site } from '../data/site';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Service Areas', path: '/service-areas/' },
];
---

<BaseLayout
  title="Service Areas in South Florida | Purix Air Duct & HVAC"
  description="Based in Miami, Purix provides air duct and HVAC cleaning in Miami-Dade, Fort Lauderdale, Boca Raton, Naples and Cape Coral. Call (305) 449-9881."
  breadcrumbs={breadcrumbs}
>
  <PageHeader
    eyebrow="Service areas"
    title="Air Duct & HVAC Cleaning Across South Florida"
    subtitle="Based in Miami, we provide air duct, AC ductwork and HVAC cleaning in Miami-Dade, Broward, Palm Beach, Collier and Lee counties."
    breadcrumbs={breadcrumbs}
  />

  <section class="section bg-white">
    <div class="container-x grid gap-6 md:grid-cols-2">
      {
        locations.map((loc, i) => (
          <article class:list={['rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-100', i === 0 && 'md:col-span-2 bg-sky-50 ring-sky-100']}>
            <h2 class="text-2xl">
              <a href={loc.path} class="hover:text-sky-500">
                {loc.city}, FL
              </a>
            </h2>
            <p class="mt-1 text-muted">{loc.county}{i === 0 && ' · Our home base'}</p>
            <h3 class="mt-6 text-sm font-bold tracking-wider text-sky-500 uppercase">Neighborhoods</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {loc.neighborhoods.map((n) => (
                <li class="rounded-full bg-white px-3 py-1.5 text-sm font-medium text-navy-800 ring-1 ring-sky-100">{n}</li>
              ))}
            </ul>
            {loc.nearby.length > 0 && (
              <>
                <h3 class="mt-6 text-sm font-bold tracking-wider text-sky-500 uppercase">Nearby communities</h3>
                <p class="mt-2 text-muted">{loc.nearby.join(' · ')}</p>
              </>
            )}
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={site.phoneHref} class="btn-navy !py-2.5">
                <Icon name="phone" class="size-4" />
                {site.phone}
              </a>
              <a href={loc.path} class="inline-flex items-center gap-1.5 px-2 font-bold text-navy-700 hover:text-sky-500">
                {loc.city} services <Icon name="arrowRight" class="size-4" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <ServicesSection title="Services Available in Every Area" bg="sky" />

  <Reviews />

  <section class="section bg-navy-950">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow !text-lime-500">Not sure if we cover your area?</p>
        <h2 class="text-3xl !text-white sm:text-4xl">Send us a request</h2>
        <p class="mt-4 text-lg text-white/80">Enter your address and we’ll confirm service availability and get back to you to schedule.</p>
      </div>
      <QuoteForm />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
