---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/images/purix-logo.png';
import { site, locations } from '../data/site';
import { services } from '../data/services';

const socials = [
  { name: 'facebook', href: site.social.facebook, label: 'Facebook' },
  { name: 'instagram', href: site.social.instagram, label: 'Instagram' },
  { name: 'youtube', href: site.social.youtube, label: 'YouTube' },
  { name: 'tiktok', href: site.social.tiktok, label: 'TikTok' },
  { name: 'pinterest', href: site.social.pinterest, label: 'Pinterest' },
  { name: 'x', href: site.social.x, label: 'X (Twitter)' },
];

const year = new Date().getFullYear();
---

<footer class="bg-navy-950 text-white/75">
  <div class="container-x grid gap-12 py-16 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <a href="/" class="inline-block rounded-2xl bg-white p-3" aria-label="Purix Air Duct Cleaning home">
        <Image src={logo} alt="Purix Air Duct Cleaning" width={230} height={121} class="h-16 w-auto" />
      </a>
      <p class="mt-5 max-w-sm leading-relaxed">
        {site.tagline}. Professional air duct, dryer vent and HVAC cleaning for homes and businesses in Cape Coral, Naples, Fort Lauderdale and Boca Raton, Florida.
      </p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={`Purix Air Duct Cleaning on ${s.label}`}
                class="flex size-10 items-center justify-center rounded-full bg-white/10 transition hover:bg-sky-500 hover:text-white"
              >
                <Icon name={s.name} class="size-[18px]" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-2">
      <h2 class="text-base font-bold text-white">Services</h2>
      <ul class="mt-4 space-y-2.5">
        {
          services.map((s) => (
            <li>
              <a href={s.path} class="hover:text-lime-500">
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-2">
      <h2 class="text-base font-bold text-white">Company</h2>
      <ul class="mt-4 space-y-2.5">
        <li><a href="/about-us/" class="hover:text-lime-500">About Us</a></li>
        <li><a href="/service-areas/" class="hover:text-lime-500">Service Areas</a></li>
        <li><a href="/blog/" class="hover:text-lime-500">Blog</a></li>
        <li><a href="/contact-us/" class="hover:text-lime-500">Contact Us</a></li>
        <li><a href="/privacy-policy/" class="hover:text-lime-500">Privacy Policy</a></li>
      </ul>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:col-span-4">
      {
        locations.map((loc) => (
          <address class="not-italic">
            <h2 class="text-base font-bold text-white">
              <a href={loc.path} class="hover:text-lime-500">
                {loc.city}
              </a>
            </h2>
            <p class="mt-2 text-sm leading-relaxed">
              {loc.street}
              <br />
              {loc.city}, FL {loc.zip}
            </p>
            <a href={loc.phoneHref} class="mt-1 inline-flex items-center gap-1.5 text-sm font-bold text-white hover:text-lime-500">
              <Icon name="phone" class="size-3.5 text-sky-400" />
              {loc.phone}
            </a>
          </address>
        ))
      }
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>
        <a href="/privacy-policy/" class="hover:text-white">Privacy Policy</a>
        <span class="mx-2 text-white/30">|</span>
        <a href="/sitemap-index.xml" class="hover:text-white">Sitemap</a>
      </p>
    </div>
  </div>
</footer>
