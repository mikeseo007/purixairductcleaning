---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/images/purix-mark.png';
import { site, regions, locationsByRegion, type Location } from '../data/site';
import { getLocationLogo } from '../data/location-logos';
import { serviceGroups, servicesByGroup } from '../data/services';

interface Props {
  location?: Location;
}

const { location } = Astro.props;

// Location-branded footer: the location's own logo, business name, address and
// phone. Email stays the sitewide address. Pages without a NAP are unchanged.
const nap = location?.nap;
const isLocationBrand = Boolean(nap);
const brandLogo = (location && getLocationLogo(location.slug)) || logo;
const brandName = nap?.businessName ?? site.name;
const phone = nap?.phone ?? site.phone;
const phoneHref = nap?.phoneHref ?? site.phoneHref;
const contactHref = nap ? '#quote' : '/contact-us/';
const addrStreet = nap ? nap.street : site.address.street;
const addrCityLine = nap
  ? `${nap.city}, ${nap.region}${nap.zip ? ` ${nap.zip}` : ''}`
  : `${site.address.city}, ${site.address.region} ${site.address.zip}`;
const addressHref = nap ? nap.mapsUrl : site.mapsUrl;

const socials = [
  { name: 'facebook', href: site.social.facebook, label: 'Facebook' },
  { name: 'instagram', href: site.social.instagram, label: 'Instagram' },
  { name: 'youtube', href: site.social.youtube, label: 'YouTube' },
  { name: 'tiktok', href: site.social.tiktok, label: 'TikTok' },
  { name: 'pinterest', href: site.social.pinterest, label: 'Pinterest' },
  { name: 'x', href: site.social.x, label: 'X (Twitter)' },
];

const year = new Date().getFullYear();
---

<footer class="relative isolate overflow-hidden bg-navy-950 text-white/70">
  <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-80 w-[60rem] -translate-x-1/2 rounded-full bg-sky-500/15 blur-[120px]"></div>
  <div class="h-px bg-gradient-to-r from-transparent via-sky-400/50 to-transparent"></div>
  <div class="container-x grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-4">
      <a href="/" class="inline-flex max-w-full items-center gap-3 rounded-2xl bg-white py-3 pr-4 pl-3 sm:gap-4 sm:pr-5 sm:pl-4" aria-label={`${brandName} home`}>
        <Image src={brandLogo} alt={`${brandName} logo`} title={brandName} format="webp" width={isLocationBrand ? 360 : 144} densities={[1, 2]} class={isLocationBrand ? 'h-16 w-auto shrink-0 sm:h-[4.5rem]' : 'h-14 w-auto shrink-0 sm:h-16'} />
        {
          !isLocationBrand && (
            <span class="border-l-2 border-slate-200 pl-4 font-display text-[0.9rem] leading-[1.15] font-bold tracking-[0.06em] text-navy-900 uppercase">
              Air Duct &amp;<br /><span class="text-navy-700">Dryer Vent Cleaning</span>
            </span>
          )
        }
      </a>
      <address class="mt-6 space-y-3 not-italic">
        <p class="font-bold text-white">{brandName}</p>
        {
          addressHref ? (
            <a href={addressHref} target="_blank" rel="noopener" class="flex items-start gap-2.5 hover:text-white">
              <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-sky-400" />
              <span>{addrStreet && <>{addrStreet}<br /></>}{addrCityLine}</span>
            </a>
          ) : (
            <p class="flex items-start gap-2.5">
              <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-sky-400" />
              <span>{addrStreet && <>{addrStreet}<br /></>}{addrCityLine}</span>
            </p>
          )
        }
        <a href={phoneHref} class="flex items-center gap-2.5 font-bold text-white hover:text-lime-500">
          <Icon name="phone" class="size-5 shrink-0 text-sky-400" />
          {phone}
        </a>
        <a href={`mailto:${site.email}`} class="flex items-center gap-2.5 hover:text-white">
          <Icon name="mail" class="size-5 shrink-0 text-sky-400" />
          {site.email}
        </a>
        <p class="flex items-start gap-2.5">
          <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-sky-400" />
          <span>Open 24 hours a day<br />7 days a week</span>
        </p>
      </address>
      {
        !isLocationBrand && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${site.shortName} on ${s.label}`}
                  class="flex size-10 items-center justify-center rounded-full bg-white/10 transition hover:bg-sky-500 hover:text-white"
                >
                  <Icon name={s.name} class="size-[18px]" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="hidden gap-10 sm:grid-cols-2 md:grid lg:col-span-5">
      {
        serviceGroups.map((g) => (
          <div>
            <h2 class="text-base font-bold text-white">
              <a href={g.hub} class="hover:text-lime-500">{g.name}</a>
            </h2>
            <ul class="mt-4 space-y-2.5">
              {servicesByGroup(g.id).map((s) => (
                <li>
                  <a href={s.path} class="hover:text-lime-500">
                    {s.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="hidden md:block lg:col-span-3">
      <p class="text-base font-bold text-white">Company</p>
      <ul class="mt-4 space-y-2.5">
        <li><a href="/about-us/" class="hover:text-lime-500">About Us</a></li>
        <li><a href="/our-services/" class="hover:text-lime-500">All Services</a></li>
        <li><a href="/service-areas/" class="hover:text-lime-500">Service Areas</a></li>
        <li><a href="/blog/" class="hover:text-lime-500">Blog</a></li>
        <li><a href={contactHref} class="hover:text-lime-500">Contact Us</a></li>
      </ul>
    </div>

    <div class="hidden border-t border-white/10 pt-10 md:block lg:col-span-12">
      <p class="text-base font-bold text-white">
        <a href="/service-areas/" class="hover:text-lime-500">Service Areas</a>
      </p>
      <div class="mt-4 grid gap-6 md:grid-cols-3">
        {
          regions.map((r) => (
            <div>
              <p class="text-xs font-bold tracking-wider text-white/50 uppercase">{r.name}</p>
              <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
                {locationsByRegion(r.id).map((l) => (
                  <li>
                    <a href={l.path} class="hover:text-lime-500">{l.city}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {brandName}. All rights reserved.</p>
      <p>
        <a href="/privacy-policy/" class="hover:text-white">Privacy Policy</a>
        <span class="mx-2 text-white/30">|</span>
        <a href="/terms/" class="hover:text-white">Terms &amp; Conditions</a>
        <span class="mx-2 text-white/30">|</span>
        <a href="/sitemap-index.xml" class="hover:text-white">Sitemap</a>
      </p>
    </div>
  </div>
</footer>
