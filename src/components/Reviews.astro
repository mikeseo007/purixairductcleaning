---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { reviews } from '../data/site';

interface Props {
  title?: string;
  limit?: number;
}

const { title = 'What Our Customers Say', limit = 6 } = Astro.props;
const list = reviews.slice(0, limit);
---

<section class="section bg-white">
  <div class="container-x">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <SectionHeading eyebrow="Customer reviews" title={title} />
      <div class="flex items-center gap-3 rounded-2xl border border-slate-100 bg-white px-5 py-3 shadow-sm">
        <Icon name="google" class="size-7 text-[#4285F4]" />
        <div>
          <div class="flex text-amber-400">
            {Array.from({ length: 5 }).map(() => <Icon name="star" class="size-4" />)}
          </div>
          <p class="text-sm font-semibold text-ink">5-star reviews on Google</p>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        list.map((r) => (
          <figure class="flex flex-col rounded-3xl border border-slate-100 bg-sky-50/60 p-7">
            <div class="flex text-amber-400" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => <Icon name="star" class="size-5" />)}
            </div>
            <blockquote class="mt-4 flex-1 text-lg leading-relaxed text-ink">“{r.text}”</blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span class="flex size-11 items-center justify-center rounded-full bg-navy-700 font-bold text-white">{r.name.charAt(0)}</span>
              <span>
                <span class="block font-bold text-navy-900">{r.name}</span>
                <span class="block text-sm text-muted">{r.service}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
