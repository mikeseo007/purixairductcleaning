---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import TrustBar from './TrustBar.astro';
import SplitSection from './SplitSection.astro';
import SectionHeading from './SectionHeading.astro';
import ServicesSection from './ServicesSection.astro';
import HvacHighlight from './HvacHighlight.astro';
import ProcessSteps from './ProcessSteps.astro';
import Reviews from './Reviews.astro';
import LocationsSection from './LocationsSection.astro';
import GoogleMap from './GoogleMap.astro';
import FAQ from './FAQ.astro';
import CtaBand from './CtaBand.astro';
import Icon from './Icon.astro';
import { getLocation, locations, site, fullAddress } from '../data/site';
import { locationContent } from '../data/location-content';
import { businessSchema, faqSchema, breadcrumbSchema } from '../data/schema';
import type { ImageMetadata } from 'astro';
import { photos, pickPhoto, usedKeys, vehicles, familyOf, type Photo } from '../data/photos';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const location = getLocation(slug);
const c = locationContent[slug];
const isHome = location.path === '/';
// A location with its own NAP drives its own phone number (and, on this page,
// its own contact block + Google Maps link) instead of the Miami office.
const nap = location.nap;
const phone = { label: nap?.phone ?? site.phone, href: nap?.phoneHref ?? site.phoneHref };
// Every company-vehicle photo has the Miami phone number printed on the wrap, so
// none of them can appear on a dedicated-location page (the number would be
// wrong for that city). On NAP pages we seed every photo pick with the vehicle
// set marked "used" and choose the hero/local from phone-free work shots.
const locIndex = Math.max(0, locations.findIndex((l) => l.slug === location.slug));
const rotate = <T,>(arr: T[], by: number) => [...arr.slice(by % arr.length), ...arr.slice(0, by % arr.length)];

let hero: Photo;
let local: { src: ImageMetadata; alt: string };
let goodToKnowPhoto: Photo;
let pagePhotos: ImageMetadata[];

if (nap) {
  // Seed with all vehicle photos + the authored (phone-free) intro so nothing
  // repeats and no vehicle shot can slip in via pickPhoto's vehicle fallback.
  const used = new Set(usedKeys(vehicles.map((v) => v.src)));
  used.add(familyOf(c.introImage));
  used.add(c.introImage.src);

  // Hero intentionally keeps the original branded-van photo (per request), even
  // though its wrap shows the Miami phone number. Every other section on the page
  // stays phone-free (local split, "good to know", service tiles).
  hero = photos.vanDryerCrew;

  // Keep the authored local image if it is phone-free; otherwise pick a work shot.
  const localIsVehicle = vehicles.some((v) => v.src.src === c.localImage.src);
  if (localIsVehicle) {
    const localPool = [photos.hvacFilterService, photos.ceilingVentHose, photos.airHandlerCleaning, photos.hvacCoilCleaning, photos.blowerCleaning, photos.furnaceFilter, photos.ductCamera, photos.dryerVentExterior];
    const p = pickPhoto(rotate(localPool, locIndex), used, { minWidth: 760 });
    local = { src: p.src, alt: p.alt };
  } else {
    local = { src: c.localImage, alt: c.localImageAlt };
    used.add(familyOf(c.localImage));
    used.add(c.localImage.src);
  }

  const gkPool = [photos.ceilingInspection, photos.ductCamera, photos.ceilingVentHose, photos.negativeAirHose, photos.hvacFilterService, photos.furnaceFilter, photos.hvacCoilCleaning, photos.airHandlerCleaning, photos.blowerCleaning, photos.dryerVentExterior];
  goodToKnowPhoto = pickPhoto(rotate(gkPool, locIndex), used, { minWidth: 800, landscape: true });

  pagePhotos = [hero.src, c.introImage, local.src, goodToKnowPhoto.src];
} else {
  hero = photos.vanDryerCrew;
  local = c.localImage.src === hero.src.src ? { src: c.heroImage, alt: c.heroImageAlt } : { src: c.localImage, alt: c.localImageAlt };

  // "Good to know" section photo, rotated across location pages so each city shows a
  // different, relevant shot. pickPhoto skips any image/family already on the page.
  const gallery = [photos.ceilingInspection, photos.ductCamera, photos.ceilingVentHose, photos.negativeAirHose, photos.hvacFilterService, photos.furnaceFilter, photos.hvacCoilCleaning, photos.airHandlerCleaning, photos.blowerCleaning, photos.dryerVentExterior, photos.vanDuctCrew, photos.teamWithVan, photos.serviceTrucks];
  goodToKnowPhoto = pickPhoto(rotate(gallery, locIndex), new Set(usedKeys([hero.src, c.introImage, c.localImage])), { minWidth: 800, landscape: true });

  pagePhotos = [hero.src, c.introImage, local.src, goodToKnowPhoto.src, ...(isHome ? [photos.hvacCoilCleaning.src] : [])];
}
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(fullAddress)}`;

// Why Choose Us — the company's verified, sitewide strengths, framed for this city.
const whyChooseUs = [
  { icon: 'checkCircle', title: 'Air duct & vent specialists', text: `Air duct, dryer vent and HVAC cleaning is our focus, so ${location.city} gets technicians who do this work every day.` },
  { icon: 'building', title: 'Residential & commercial', text: 'We clean houses, condos and townhomes as well as offices, retail and managed properties.' },
  { icon: 'tag', title: 'Upfront, honest quotes', text: 'You get a clear quote before any work begins, with no surprise add-ons once we get started.' },
  { icon: 'clock', title: 'Open 24 hours, 7 days', text: `We are available 24 hours a day, 7 days a week, so you can book ${location.city} service when it suits you.` },
];

const breadcrumbs = isHome
  ? undefined
  : [
      { name: 'Home', path: '/' },
      { name: 'Service Areas', path: '/service-areas/' },
      { name: location.city, path: location.path },
    ];
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
  location={location}
  breadcrumbs={breadcrumbs}
  schema={isHome ? [businessSchema()] : [faqSchema(c.faqs), breadcrumbSchema(breadcrumbs!)]}
>
  {/* 1 — Hero */}
  <Hero
    eyebrow={isHome ? site.name : `Serving ${location.city} & ${location.county}`}
    title={c.h1}
    subtitle={c.heroSubtitle}
    image={hero.src}
    imageAlt={hero.alt}
    location={location}
    breadcrumbs={breadcrumbs}
  />
  <TrustBar />

  {/* 2 — Why Choose Us */}
  <section class="section bg-white">
    <div class="container-x">
      <SectionHeading
        eyebrow="Why choose us"
        title={`Why ${location.city} chooses Purix`}
        intro={`Purix provides Air Duct Cleaning in ${location.city} for homes, condos and businesses, backed by these everyday strengths.`}
        centerDesktop
      />
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {
          whyChooseUs.map((w) => (
            <div class="card card-hover spotlight flex h-full flex-col p-7">
              <span class="icon-chip size-12">
                <Icon name={w.icon} class="size-6" />
              </span>
              <h3 class="mt-6 text-xl sm:min-h-[3.5rem]">{w.title}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-muted">{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 3 — Our Services */}
  <ServicesSection
    title={isHome ? 'Air Duct, Dryer Vent & HVAC Cleaning Services' : `Our Services in ${location.city}`}
    intro={isHome
      ? undefined
      : `Ductwork and AC system cleaning for homes and businesses in ${location.city}, FL, plus dryer vent and attic insulation services.`}
    city={isHome ? undefined : location.city}
    bg="sky"
    avoid={nap ? [...pagePhotos, ...vehicles.map((v) => v.src)] : pagePhotos}
    phone={phone}
  />

  {/* 4 — SEO content section 1 */}
  <SplitSection
    eyebrow={`Air duct cleaning · ${location.city}`}
    heading={c.introHeading}
    paragraphs={c.intro}
    image={c.introImage}
    imageAlt={c.introImageAlt}
    phone={phone}
  />

  {/* 5 — Testimonials */}
  <Reviews tint showLeaveReview={!nap} />

  {/* 6 — Our Process (start of second half) */}
  <ProcessSteps dark headingCenterDesktop />

  {/* 7 — SEO content section 2 */}
  <SplitSection
    eyebrow={`Serving ${location.city}, FL`}
    heading={c.localHeading}
    paragraphs={c.local}
    image={local.src}
    imageAlt={local.alt}
    reverse
    tint={!isHome}
    phone={phone}
  />

  {/* 8 — SEO content section 3 (local guide): gradient feature panel */}
  <section class="section bg-white">
    <div class="container-x">
      <div
        class="relative overflow-hidden rounded-[2.5rem] border border-slate-200/70 bg-gradient-to-br from-sky-50 via-white to-lime-50/40 p-8 shadow-[0_1px_2px_rgb(13_31_77/0.04),0_30px_60px_-30px_rgb(13_31_77/0.25)] sm:p-12 lg:p-14"
        data-reveal
      >
        <div class="pointer-events-none absolute -top-24 -right-16 -z-10 size-72 rounded-full bg-sky-200/40 blur-3xl" aria-hidden="true"></div>
        <div class="grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-14">
          <div class="lg:col-span-5">
            <span class="icon-chip size-14"><Icon name="pin" class="size-7" /></span>
            <p class="eyebrow mt-6">Local guide</p>
            <h2 class="text-[1.9rem] leading-[1.12] sm:text-4xl">{c.extraSeo[0].heading}</h2>
          </div>
          <div class="space-y-4 lg:col-span-7">
            {c.extraSeo[0].body.map((p) => <p class="text-lg leading-relaxed text-muted">{p}</p>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 9 — SEO content section 4 (good to know): text + rotating local photo */}
  <SplitSection
    eyebrow="Good to know"
    heading={c.extraSeo[1].heading}
    paragraphs={c.extraSeo[1].body}
    image={goodToKnowPhoto.src}
    imageAlt={goodToKnowPhoto.alt}
    tint
  />

  {/* Homepage-only: related air-side keywords (ductwork cleaning, AC vent cleaning, vent cleaning umbrella). H1 stays "Air Duct Cleaning in Miami". */}
  {isHome && c.homeSections && (
    <section class="section bg-surface">
      <div class="container-x">
        <SectionHeading
          eyebrow="More ways we clean your air"
          title="Ductwork, AC Vent & Dryer Vent Cleaning in Miami"
          intro="Air duct cleaning is the core of what we do in Miami. Here is how the closely related searches fit together, and which service each one points to."
          centerDesktop
        />
        <div class="mt-12 grid gap-6 lg:grid-cols-2" data-stagger>
          {c.homeSections.map((s) => (
            <article class="card card-hover spotlight flex flex-col p-7 sm:p-8">
              <h3 class="text-2xl">
                <a href={s.href} class="hover:text-sky-500">{s.heading}</a>
              </h3>
              {s.body.map((p) => <p class="mt-3 leading-relaxed text-muted">{p}</p>)}
              <a href={s.href} class="mt-5 inline-flex items-center gap-1.5 font-bold text-navy-700 hover:text-sky-500">
                Learn more <Icon name="arrowRight" class="size-4" />
              </a>
            </article>
          ))}
        </div>
        <p class="mx-auto mt-8 max-w-3xl text-center text-muted">
          Searching for <strong class="font-semibold text-navy-800">vent cleaning</strong>? It splits two ways: <a href="/ac-vent-cleaning/" class="font-semibold text-navy-700 underline hover:text-sky-500">AC vent cleaning</a> for the registers and grilles you can see, with <a href="/ductwork-cleaning/" class="font-semibold text-navy-700 underline hover:text-sky-500">ductwork cleaning</a> for the runs behind them, and <a href="/dryer-vent-cleaning/" class="font-semibold text-navy-700 underline hover:text-sky-500">dryer vent cleaning</a> for the lint line on your clothes dryer.
        </p>
      </div>
    </section>
  )}

  {isHome && <HvacHighlight />}

  {/* 10 — Service Areas */}
  <LocationsSection title="Areas We Serve" current={location.slug} showMap={false} headingCenterDesktop phone={phone} />

  {/* 11 — Points of interest & directions (city pages only, not the homepage) */}
  {!isHome && (
  <section class="section relative isolate overflow-hidden bg-navy-950 text-white">
    <div class="drift pointer-events-none absolute -top-48 -left-40 -z-10 size-[34rem] rounded-full bg-sky-500/20 blur-[120px]"></div>
    <div class="drift pointer-events-none absolute -right-32 -bottom-56 -z-10 size-[30rem] rounded-full bg-lime-500/15 blur-[120px] [animation-delay:-7s]"></div>
    <div class="container-x relative">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow !text-lime-400">Local area</p>
        <h2 class="text-[2rem] leading-[1.1] !text-white sm:text-[2.6rem]">Points of interest around {location.city}</h2>
        <p class="mt-4 text-lg text-white/70">
          When we handle Air Duct Cleaning in {location.city}, we cover the whole city and the areas around recognizable local spots like these.
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {
          c.pois.map((p) => (
            <div class="flex h-full gap-4 rounded-2xl bg-white/[0.05] p-5 ring-1 ring-white/10">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-lime-500/15 text-lime-400">
                <Icon name="pin" class="size-5" />
              </span>
              <span>
                <span class="block font-bold text-white">{p.name}</span>
                <span class="mt-0.5 block text-sm leading-relaxed text-white/60">{p.note}</span>
              </span>
            </div>
          ))
        }
      </div>

      <div class="mt-8">
        <p class="font-bold text-white">Neighborhoods we serve</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            location.neighborhoods.map((n) => (
              <li class="rounded-full bg-white/[0.06] px-3 py-1.5 text-sm font-medium text-white/85 ring-1 ring-white/10">{n}</li>
            ))
          }
        </ul>
        {
          location.nearby.length > 0 && (
            <p class="mt-4 text-white/60">
              <span class="font-bold text-white">Also nearby:</span> {location.nearby.join(', ')}
            </p>
          )
        }
      </div>

      {
        nap ? (
          <div class="mt-10 flex flex-col gap-6 border-t border-white/10 pt-9 lg:flex-row lg:items-start lg:justify-between" data-reveal>
            <div>
              <p class="font-bold text-white">Visit Purix in {location.city}</p>
              <address class="mt-3 space-y-2 text-white/75 not-italic">
                <p class="font-semibold text-white">{nap.businessName}</p>
                <p class="flex items-start gap-2.5">
                  <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-lime-400" />
                  <span>
                    {nap.street && (
                      <>
                        {nap.street}
                        <br />
                      </>
                    )}
                    {nap.city}, {nap.region}
                    {nap.zip ? ` ${nap.zip}` : ''}
                  </span>
                </p>
                <a href={phone.href} class="flex items-center gap-2.5 font-semibold text-white hover:text-lime-400">
                  <Icon name="phone" class="size-5 shrink-0 text-lime-400" />
                  {phone.label}
                </a>
                <a href={`mailto:${site.email}`} class="flex items-center gap-2.5 hover:text-white">
                  <Icon name="mail" class="size-5 shrink-0 text-lime-400" />
                  {site.email}
                </a>
              </address>
            </div>
            {nap.mapsUrl && (
              <a
                href={nap.mapsUrl}
                target="_blank"
                rel="noopener"
                class="group inline-flex w-fit items-center gap-2 rounded-full bg-white/10 px-5 py-2.5 text-sm font-semibold ring-1 ring-white/20 transition hover:bg-white/20"
              >
                <Icon name="pin" class="size-4 text-lime-400" />
                View on Google Maps
                <Icon name="arrowRight" class="size-4 text-lime-400 transition group-hover:translate-x-1" />
              </a>
            )}
          </div>
        ) : (
          <>
            <div class="mt-10" data-reveal>
              <p class="font-bold text-white">Driving directions from {location.city} to our Miami base</p>
              <div class="mt-4 overflow-hidden rounded-[1.75rem] bg-white/[0.06] p-1.5 ring-1 ring-white/10">
                <iframe
                  src={c.directionsEmbed}
                  title={`Driving directions from ${location.city}, FL to Purix Air Duct Cleaning in Miami`}
                  class="h-[340px] w-full rounded-[1.4rem] border-0 sm:h-[460px]"
                  loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen></iframe>
              </div>
            </div>

            <div class="mt-9 flex flex-col gap-4 border-t border-white/10 pt-7 sm:flex-row sm:items-center sm:justify-between">
              <p class="max-w-xl text-white/70">
                Purix delivers Air Duct Cleaning in {location.city} as a mobile service that travels to you; our home base is in Miami, FL.
              </p>
              <a
                href={directionsUrl}
                target="_blank"
                rel="noopener"
                class="group inline-flex w-fit items-center gap-2 rounded-full bg-white/10 px-5 py-2.5 text-sm font-semibold ring-1 ring-white/20 transition hover:bg-white/20"
              >
                <Icon name="pin" class="size-4 text-lime-400" />
                Directions to our Miami base
                <Icon name="arrowRight" class="size-4 text-lime-400 transition group-hover:translate-x-1" />
              </a>
            </div>
          </>
        )
      }
    </div>
  </section>
  )}

  {/* 12 — FAQ */}
  <FAQ faqs={c.faqs} title={`Air Duct Cleaning FAQs: ${location.city}`} tint phone={phone} />

  {/* 13 — Google Business Profile map. Only on pages that use the Miami profile;
      dedicated-NAP location pages show their own Maps link above and must not
      embed the Miami Google profile. */}
  {!nap && (
    <section class="section bg-white">
      <div class="container-x">
        <SectionHeading eyebrow="Find us on Google" title="Purix Air Duct & Dryer Vent Cleaning" center />
        <div class="mx-auto mt-10 h-[350px] max-w-5xl" data-reveal>
          <GoogleMap class="h-full" />
        </div>
      </div>
    </section>
  )}

  {/* 14 — Final CTA */}
  <CtaBand
    title={`Need air duct or dryer vent cleaning in ${location.city}?`}
    phone={phone.label}
    phoneHref={phone.href}
    quoteHref={nap ? '#quote' : undefined}
  />
</BaseLayout>
