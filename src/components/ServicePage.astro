---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import TrustBar from './TrustBar.astro';
import SplitSection from './SplitSection.astro';
import SectionHeading from './SectionHeading.astro';
import ProcessSteps from './ProcessSteps.astro';
import Reviews from './Reviews.astro';
import LocationsSection from './LocationsSection.astro';
import GoogleMap from './GoogleMap.astro';
import FAQ from './FAQ.astro';
import CtaBand from './CtaBand.astro';
import Icon from './Icon.astro';
import { getService, serviceGroups } from '../data/services';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../data/schema';
import { site } from '../data/site';
import { asPhoto, photos, pickPhoto } from '../data/photos';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const s = getService(slug);
const group = serviceGroups.find((g) => g.id === s.group)!;
const parent = s.parent ? getService(s.parent) : undefined;
const used = new Set<string>();
const ownPhotos = [asPhoto(s.image, s.imageAlt), asPhoto(s.secondImage, s.secondImageAlt)];
const heroPhoto = pickPhoto([photos.vanDryerCrew], used);
const introPhoto = pickPhoto(ownPhotos, used, { minWidth: 800 });
const related = s.related.map((slug) => {
  const r = getService(slug);
  const photo = pickPhoto([asPhoto(r.image, r.imageAlt), asPhoto(r.secondImage, r.secondImageAlt)], used, { minWidth: 900 });
  return { ...r, image: photo.src, imageAlt: photo.alt };
});

// Why Choose Us — built from the company's verified, sitewide facts (specialist
// focus, residential + commercial, upfront quotes, 24/7 availability). Only the
// first card is service-specific; the rest are shared business facts.
const whyChooseUs = [
  { icon: 'checkCircle', title: 'Air duct & vent specialists', text: `${s.name} is our focus, not a sideline, handled by technicians who do this work every day.` },
  { icon: 'building', title: 'Residential & commercial', text: 'We work in houses, condos and townhomes as well as offices, retail and managed properties across South Florida.' },
  { icon: 'tag', title: 'Upfront, honest quotes', text: 'You get a clear quote before any work begins, with no surprise add-ons once the job is underway.' },
  { icon: 'clock', title: 'Open 24 hours, 7 days', text: 'Purix is available 24 hours a day, 7 days a week, so you can book at a time that works for you.' },
];

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/our-services/' },
  ...(parent ? [{ name: parent.name, path: parent.path }] : []),
  { name: s.name, path: s.path },
];
---

<BaseLayout title={s.metaTitle} description={s.metaDescription} breadcrumbs={breadcrumbs} schema={[serviceSchema(s), faqSchema(s.faqs), breadcrumbSchema(breadcrumbs)]}>
  {/* 1 — Hero */}
  <Hero
    eyebrow={group.name}
    title={s.h1}
    subtitle={s.heroSubtitle}
    image={heroPhoto.src}
    imageAlt={heroPhoto.alt}
    service={s.name}
    breadcrumbs={breadcrumbs}
  />
  <TrustBar />

  {/* 2 — Why Choose Us */}
  <section class="section bg-white">
    <div class="container-x">
      <SectionHeading eyebrow="Why choose us" title={`Reasons to choose Purix for ${s.name}`} centerDesktop />
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {
          whyChooseUs.map((w) => (
            <div class="card card-hover spotlight flex h-full flex-col p-7">
              <span class="icon-chip size-12">
                <Icon name={w.icon} class="size-6" />
              </span>
              <h3 class="mt-6 text-xl sm:min-h-[3.5rem]">{w.title}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-muted">{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 3 — Our Services (related services we offer, with internal links) */}
  <section class="bg-surface section" data-slider>
    <div class="container-x">
      <div class="flex items-end justify-between gap-6" data-reveal>
        <div>
          <p class="eyebrow">Our services</p>
          <h2 class="text-3xl sm:text-4xl">Services we also offer</h2>
        </div>
        <div class="flex items-center gap-5">
          <a href="/our-services/" class="hidden items-center gap-1.5 font-bold text-navy-700 hover:text-sky-500 sm:inline-flex">
            All services <Icon name="arrowRight" class="size-4" />
          </a>
          <div class="hidden items-center gap-2" data-slider-nav>
            <button type="button" class="slider-btn" aria-label="Previous services" data-slider-prev>
              <Icon name="chevronRight" class="size-5 rotate-180" />
            </button>
            <button type="button" class="slider-btn" aria-label="Next services" data-slider-next>
              <Icon name="chevronRight" class="size-5" />
            </button>
          </div>
        </div>
      </div>
      <ul
        class="-mx-1 mt-4 flex snap-x snap-mandatory scroll-px-1 gap-6 overflow-x-auto scroll-smooth px-1 py-6 [justify-content:safe_center] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        data-slider-track
        data-stagger
      >
        {
          related.map((r) => (
            <li class="w-[82%] shrink-0 snap-start sm:w-[calc(50%-12px)] lg:w-[calc(25%-18px)]">
              <a href={r.path} class="card card-hover group flex h-full flex-col overflow-hidden">
                <span class="relative block aspect-[16/10] overflow-hidden bg-navy-950">
                  <Image
                    src={r.image}
                    alt={r.imageAlt}
                    title={r.imageAlt}
                    format="webp"
                    widths={[400, 640, 800, 1000, 1200]}
                    sizes="(min-width: 1280px) 290px, (min-width: 1024px) 23vw, (min-width: 640px) 50vw, 82vw"
                    class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105"
                  />
                  <span class="absolute inset-0 bg-gradient-to-t from-navy-950/60 via-transparent to-transparent" />
                  <span class="icon-chip absolute bottom-4 left-4 size-11 rounded-xl ring-2 ring-white/20">
                    <Icon name={r.icon} class="size-5" />
                  </span>
                </span>
                <span class="flex flex-1 flex-col p-6">
                  <span class="font-display text-lg leading-snug font-bold text-navy-900 lg:min-h-[3.25rem]">{r.name}</span>
                  <span class="mt-2 flex-1 text-sm leading-relaxed text-muted">{r.card}</span>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-navy-900">
                    View service
                    <span class="flex size-7 items-center justify-center rounded-full bg-surface transition group-hover:translate-x-1 group-hover:bg-lime-400">
                      <Icon name="arrowRight" class="size-3.5" />
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 4 — SEO content section 1: what the service covers */}
  <SplitSection eyebrow={s.name} heading={s.introHeading} paragraphs={s.intro} image={introPhoto.src} imageAlt={introPhoto.alt} phone={{ label: site.phone, href: site.phoneHref }} />

  {/* 5 — Testimonials */}
  <Reviews tint />

  {/* 6 — Our Process (start of second half) */}
  <ProcessSteps title={s.processHeading} steps={s.process} dark />

  {/* 7 — SEO content section 2: what's included */}
  <section class="section relative overflow-hidden bg-surface">
    <div class="container-x relative">
      <SectionHeading eyebrow="What’s included" title={s.componentsHeading} centerDesktop />
      <div
        class:list={['mt-14 grid gap-6', s.components.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2 lg:grid-cols-3']}
        data-stagger
      >
        {
          s.components.map((c, i) => (
            <div class="card card-hover spotlight flex h-full flex-col p-7">
              <div class="flex items-center justify-between">
                <span class="icon-chip size-12"><Icon name={s.icon} class="size-6" /></span>
                <span class="font-display text-3xl font-bold text-sky-100">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="mt-6 text-xl sm:min-h-[3.5rem]">{c.title}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-muted">{c.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 8 — SEO content section 3: warning signs */}
  <section class="section bg-white">
    <div class="container-x">
      <div class="max-w-3xl lg:mx-auto lg:text-center" data-reveal>
        <p class="eyebrow lg:justify-center">Warning signs</p>
        <h2 class="text-3xl sm:text-4xl">{s.signsHeading}</h2>
      </div>
      <ul class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-2" data-stagger>
        {
          s.signs.map((sign) => (
            <li class="flex gap-4 rounded-2xl border border-slate-200/70 bg-surface p-5">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-lime-500/15 text-lime-600">
                <Icon name="alert" class="size-5" />
              </span>
              <span class="pt-1 leading-relaxed text-muted">{sign}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 9 — SEO content section 4: benefits / what to expect */}
  <section class="section relative isolate overflow-hidden bg-navy-950 text-white">
    <div class="drift pointer-events-none absolute top-1/3 -right-40 -z-10 size-[34rem] rounded-full bg-sky-500/20 blur-[120px]"></div>
    <div class="container-x">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow !text-sky-400">The benefits</p>
        <h2 class="text-3xl leading-[1.1] !text-white sm:text-4xl">{s.benefitsHeading}</h2>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {
          s.benefits.map((b) => (
            <div class="spotlight flex h-full flex-col rounded-2xl bg-gradient-to-br from-white/[0.07] to-white/[0.02] p-6 ring-1 ring-white/10 transition duration-500 hover:-translate-y-1 hover:ring-sky-400/40">
              <span class="flex size-11 items-center justify-center rounded-xl bg-sky-500/15 text-sky-400">
                <Icon name="checkCircle" class="size-6" />
              </span>
              <h3 class="mt-5 text-lg !text-white sm:min-h-[3.25rem]">{b.title}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-white/65">{b.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Bonus — service-specific "good to know" note, where provided */}
  {
    s.note && (
      <section class="section bg-white">
        <div class="container-x">
          <div class="relative isolate grid overflow-hidden rounded-[2.5rem] bg-navy-950 lg:grid-cols-12" data-reveal="zoom">
            <div class="drift pointer-events-none absolute -top-40 -left-32 -z-10 size-[30rem] rounded-full bg-sky-500/25 blur-[110px]" />
            <div class="drift pointer-events-none absolute -right-24 -bottom-48 -z-10 size-[26rem] rounded-full bg-lime-500/20 blur-[110px] [animation-delay:-6s]" />
            <Icon name="shield" class="pointer-events-none absolute -right-16 -bottom-20 -z-10 size-[24rem] text-white/[0.035]" />

            <div class="relative border-b border-white/10 p-8 sm:p-12 lg:col-span-5 lg:border-r lg:border-b-0 lg:p-14">
              <span class="pulse-dot inline-flex size-16 items-center justify-center rounded-2xl bg-gradient-to-br from-lime-400 to-lime-500 text-navy-950">
                <Icon name="shield" class="size-8" />
              </span>
              <p class="mt-8 text-xs font-bold tracking-[0.22em] text-lime-400 uppercase">Good to know</p>
              <h2 class="mt-3 text-3xl leading-[1.08] !text-white sm:text-4xl lg:text-[2.75rem]">{s.note.heading}</h2>
            </div>

            <div class="relative flex flex-col justify-center p-8 sm:p-12 lg:col-span-7 lg:p-14">
              <div class="space-y-5 [&_a]:font-semibold [&_a]:text-sky-300 [&_a]:underline [&_a]:decoration-sky-300/40 [&_a]:underline-offset-4 hover:[&_a]:text-white">
                {
                  s.note.paragraphs.map((p, i) => (
                    <p class:list={['leading-relaxed', i === 0 ? 'text-lg text-white sm:text-xl' : 'text-white/70']} set:html={p} />
                  ))
                }
              </div>
              <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-white/10 pt-7">
                <span class="text-white/60">Questions about your home?</span>
                <a href={site.phoneHref} class="group inline-flex items-center gap-2 font-display text-xl font-bold text-white hover:text-lime-400">
                  <Icon name="phone" class="size-5 text-lime-400" />
                  {site.phone}
                  <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* 10 — Service Areas (links only; the map gets its own section below) */}
  <LocationsSection title={`${s.name} Service Areas`} service={s} showMap={false} />

  {/* 11 — FAQ */}
  <FAQ faqs={s.faqs} title={`${s.name} FAQs`} />

  {/* 12 — Google Business Profile map */}
  <section class="section bg-white">
    <div class="container-x">
      <SectionHeading eyebrow="Find us" title="Visit Purix on Google Maps" center />
      <div class="mx-auto mt-12 h-[350px] max-w-6xl" data-reveal>
        <GoogleMap class="h-full" />
      </div>
    </div>
  </section>

  {/* 13 — Final CTA */}
  <CtaBand title={`Schedule ${s.name} in Miami`} text={`Call ${site.phone} to schedule an inspection or get a quote. Open 24 hours a day, 7 days a week.`} />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-slider-track]');
    const nav = root.querySelector<HTMLElement>('[data-slider-nav]');
    const prev = root.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-slider-next]');
    if (!track || !nav || !prev || !next) return;
    const update = () => {
      const overflowing = track.scrollWidth > track.clientWidth + 1;
      nav.classList.toggle('hidden', !overflowing);
      nav.classList.toggle('flex', overflowing);
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };
    const step = () => {
      const card = track.firstElementChild as HTMLElement | null;
      return card ? card.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0') : track.clientWidth;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
    next.addEventListener('click', () => track.scrollBy({ left: step() }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
