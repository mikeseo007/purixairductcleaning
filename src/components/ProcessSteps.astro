---
import SectionHeading from './SectionHeading.astro';

interface Props {
  title?: string;
  eyebrow?: string;
  steps?: { title: string; text: string }[];
  dark?: boolean;
  /** Left-align the heading on mobile (centered from lg up) instead of centered on all sizes. */
  headingCenterDesktop?: boolean;
}

const defaultSteps = [
  {
    title: 'Inspect',
    text: 'We look at your vents, returns, accessible ductwork and AC equipment, and explain what we find before any work begins.',
  },
  {
    title: 'Protect',
    text: 'Floors and work areas are covered, and the duct system is put under negative air pressure so loosened debris is pulled out, not pushed into the room.',
  },
  {
    title: 'Clean',
    text: 'Brushes and air whips break buildup loose from the ductwork while the collection unit captures it. Equipment is cleaned according to the scope you approved.',
  },
  {
    title: 'Walk Through',
    text: 'We show you the results, clean the grilles and registers, and point out anything that may need attention later.',
  },
];

const { title = 'How Our Air Duct & HVAC Cleaning Works', eyebrow = 'Our process', steps = defaultSteps, dark = false, headingCenterDesktop = true } = Astro.props;
const n = steps.length;
const wide = n <= 3;
const cols = wide ? 'lg:grid-cols-3' : n === 5 ? 'xl:grid-cols-5' : 'xl:grid-cols-4';
const inset = `calc((100% - ${n - 1} * 2rem) / ${n * 2})`;

// Dark variant gives the process section its own look so it stands apart from the
// surface/white sections next to it on the service pages.
const hLine = dark ? 'from-sky-400 via-sky-300 to-lime-400' : 'from-sky-500 to-lime-500';
const vTrack = dark ? 'bg-white/15' : 'bg-sky-200/70';
const vFill = dark ? 'from-sky-400 to-lime-400' : 'from-sky-500 to-lime-500';
const circle = dark
  ? 'bg-gradient-to-br from-sky-400 to-lime-400 text-navy-950 shadow-[0_12px_30px_-8px_rgb(73_184_235/0.5)] ring-navy-950 group-hover:from-lime-400 group-hover:to-sky-400'
  : 'bg-white text-navy-900 shadow-[0_10px_30px_-10px_rgb(13_31_77/0.35)] ring-surface group-hover:bg-navy-900 group-hover:text-lime-400';
---

<section class:list={['section relative overflow-hidden', dark ? 'isolate bg-navy-950 text-white' : 'bg-surface']}>
  {
    dark && (
      <>
        <div class="drift pointer-events-none absolute -top-32 -left-24 -z-10 size-[32rem] rounded-full bg-sky-500/20 blur-[120px]" aria-hidden="true" />
        <div class="drift pointer-events-none absolute -right-24 -bottom-40 -z-10 size-[28rem] rounded-full bg-lime-500/15 blur-[120px] [animation-delay:-7s]" aria-hidden="true" />
      </>
    )
  }
  <div class="container-x relative">
    <SectionHeading eyebrow={eyebrow} title={title} center={!headingCenterDesktop} centerDesktop={headingCenterDesktop} dark={dark} />

    <div class="process relative mt-16">
      <div class:list={['absolute top-8 hidden h-[3px] rounded-full bg-gradient-to-r', hLine, wide ? 'lg:block' : 'xl:block']} style={`left:${inset};right:${inset}`} aria-hidden="true"></div>
      <div class:list={['absolute top-0 bottom-0 left-8 w-[3px] overflow-hidden rounded-full', vTrack, wide ? 'lg:hidden' : 'xl:hidden']} aria-hidden="true">
        <div class:list={['fill-line-y h-full w-full origin-top rounded-full bg-gradient-to-b', vFill]}></div>
      </div>

      <ol class:list={['relative grid gap-10 lg:gap-8', cols]} data-stagger>
        {
          steps.map((s, i) => (
            <li class:list={['group flex gap-6', wide ? 'lg:flex-col lg:items-center lg:gap-0 lg:text-center' : 'xl:flex-col xl:items-center xl:gap-0 xl:text-center']}>
              <span class:list={['relative flex size-16 shrink-0 items-center justify-center rounded-full font-display text-xl font-bold ring-[6px] transition duration-500 group-hover:scale-110', circle]}>
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class:list={['min-w-0 pt-2', wide ? 'lg:mt-7 lg:px-2 lg:pt-0' : 'xl:mt-7 xl:px-2 xl:pt-0']}>
                <h3 class:list={['text-xl sm:text-2xl', dark && '!text-white']}>{s.title}</h3>
                <p class:list={['mt-2.5 leading-relaxed', dark ? 'text-white/65' : 'text-muted']}>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
