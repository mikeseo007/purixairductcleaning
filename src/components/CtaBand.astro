---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Ready to get your AC system cleaned?',
  text = `Call to book an inspection or request a free quote. We’re open 24 hours Sunday through Friday.`,
} = Astro.props;
---

<section class="bg-white py-16 sm:py-20">
  <div class="container-x">
    <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-navy-700 via-navy-800 to-navy-950 px-6 py-12 sm:px-12 lg:flex lg:items-center lg:justify-between lg:gap-10 lg:py-14">
      <div class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-sky-500/30 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 left-1/3 size-60 rounded-full bg-lime-500/20 blur-3xl"></div>
      <div class="relative">
        <h2 class="text-3xl !text-white sm:text-4xl">{title}</h2>
        <p class="mt-3 max-w-2xl text-lg text-white/80">{text}</p>
      </div>
      <div class="relative mt-8 flex shrink-0 flex-wrap gap-3 lg:mt-0">
        <a href={site.phoneHref} class="btn-primary !px-7 !py-4 text-lg">
          <Icon name="phone" class="size-5" />
          {site.phone}
        </a>
        <a href="/contact-us/#quote" class="btn-outline !px-7 !py-4 text-lg">Get a Free Quote</a>
      </div>
    </div>
  </div>
</section>
