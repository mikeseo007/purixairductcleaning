---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  class?: string;
  dark?: boolean;
}

const { class: className = 'h-[450px]', dark = false } = Astro.props;
---

<figure
  class:list={[
    'flex h-full flex-col overflow-hidden p-1.5',
    dark ? 'rounded-[1.75rem] bg-white/[0.06] ring-1 ring-white/10 backdrop-blur' : 'card',
  ]}
>
  <div class:list={['flex flex-1 flex-col overflow-hidden rounded-[1.4rem]', dark ? 'bg-navy-900' : 'bg-sky-50']}>
  <iframe
    src={site.google.mapEmbed}
    title={`${site.name} on Google Maps`}
    class:list={['w-full flex-1 border-0', className]}
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen></iframe>
  </div>
  <figcaption class="flex flex-wrap items-center justify-between gap-2 px-4 pt-3.5 pb-2.5">
    <span class:list={['flex items-center gap-2 font-bold', dark ? 'text-white' : 'text-navy-900']}>
      <Icon name="pin" class:list={['size-5', dark ? 'text-lime-400' : 'text-sky-500']} />
      {site.name}
    </span>
    <a
      href={site.google.profileUrl}
      target="_blank"
      rel="noopener"
      class:list={['inline-flex items-center gap-1.5 text-sm font-semibold hover:underline', dark ? 'text-sky-300' : 'text-sky-600']}
    >
      <span class="flex text-[#FBBC04]"><Icon name="star" class="size-4" /></span>
      {site.google.rating.toFixed(1)} on Google · Directions
    </a>
  </figcaption>
</figure>
