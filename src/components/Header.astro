---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/images/purix-logo.png';
import { site, locations, type Location } from '../data/site';
import { services } from '../data/services';

interface Props {
  location: Location;
}

const { location } = Astro.props;
const current = Astro.url.pathname;

const serviceLinks = [
  ...services.map((s) => ({ href: s.path, label: s.name })),
  { href: '/our-services/', label: 'All Services' },
];
const locationLinks = [
  ...locations.map((l) => ({ href: l.path, label: l.city })),
  { href: '/service-areas/', label: 'All Service Areas' },
];

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about-us/', label: 'About Us' },
  { href: '/our-services/', label: 'Services', children: serviceLinks },
  { href: '/service-areas/', label: 'Locations', children: locationLinks },
  { href: '/blog/', label: 'Blog' },
  { href: '/contact-us/', label: 'Contact Us' },
];

const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<div class="bg-navy-950 text-sm text-white/85">
  <div class="container-x flex h-10 items-center justify-between gap-4">
    <p class="flex items-center gap-2 truncate">
      <Icon name="bolt" class="size-4 shrink-0 text-lime-500" />
      <span class="truncate">Same-day service in {location.slug === 'cape-coral' ? site.cities.join(', ') : `${location.city}, FL`}</span>
    </p>
    <div class="hidden shrink-0 items-center gap-5 whitespace-nowrap md:flex">
      <a href={`mailto:${location.email}`} class="hidden items-center gap-2 hover:text-white xl:flex">
        <Icon name="mail" class="size-4 text-sky-400" />
        {location.email}
      </a>
      <a href={location.phoneHref} class="flex items-center gap-2 font-bold text-white hover:text-lime-500">
        <Icon name="phone" class="size-4 text-sky-400" />
        {location.phone}
      </a>
    </div>
  </div>
</div>

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur" data-header>
  <div class="container-x flex h-20 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="Purix Air Duct Cleaning home">
      <Image src={logo} alt="Purix Air Duct Cleaning logo" width={230} height={121} loading="eager" fetchpriority="high" class="h-14 w-auto sm:h-[60px]" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) =>
            item.children ? (
              <li class="group relative">
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center gap-1 rounded-full px-4 py-2 font-semibold transition hover:text-sky-500',
                    isActive(item.href) || item.children.some((c) => c.href !== '/' && isActive(c.href)) ? 'text-sky-500' : 'text-navy-900',
                  ]}
                >
                  {item.label}
                  <Icon name="chevronDown" class="size-4 transition group-hover:rotate-180" />
                </a>
                <div class="invisible absolute top-full left-0 pt-2 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                  <ul class="w-64 rounded-2xl border border-slate-100 bg-white p-2 shadow-xl shadow-navy-900/10">
                    {item.children.map((c) => (
                      <li>
                        <a
                          href={c.href}
                          class:list={[
                            'block rounded-xl px-4 py-2.5 text-[15px] font-medium transition hover:bg-sky-50 hover:text-navy-700',
                            current === c.href ? 'bg-sky-50 text-navy-700' : 'text-ink',
                          ]}
                        >
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'rounded-full px-4 py-2 font-semibold transition hover:text-sky-500',
                    isActive(item.href) ? 'text-sky-500' : 'text-navy-900',
                  ]}
                  aria-current={current === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={location.phoneHref} class="btn-primary hidden !px-5 sm:inline-flex">
        <Icon name="phone" class="size-5" />
        {location.phone}
      </a>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-full bg-navy-900 text-white lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden max-h-[calc(100dvh-7.5rem)] overflow-y-auto border-t border-slate-200 bg-white lg:hidden" data-menu>
    <nav aria-label="Mobile" class="container-x py-4">
      <ul class="space-y-1">
        {
          nav.map((item) =>
            item.children ? (
              <li>
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl px-3 py-3 text-lg font-semibold text-navy-900 hover:bg-sky-50">
                    {item.label}
                    <Icon name="chevronDown" class="size-5 transition group-open:rotate-180" />
                  </summary>
                  <ul class="mb-2 ml-3 border-l-2 border-sky-100 pl-3">
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} class="block rounded-lg px-3 py-2.5 text-ink hover:bg-sky-50">
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={item.href} class="block rounded-xl px-3 py-3 text-lg font-semibold text-navy-900 hover:bg-sky-50">
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <a href={location.phoneHref} class="btn-primary mt-4 w-full">
        <Icon name="phone" class="size-5" />
        Call {location.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
