---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  paragraphs?: string[];
  image: ImageMetadata;
  imageAlt: string;
  reverse?: boolean;
  tint?: boolean;
  phone?: { label: string; href: string };
  headingLevel?: 'h2' | 'h3';
}

const { eyebrow, heading, paragraphs = [], image, imageAlt, reverse = false, tint = false, phone, headingLevel: H = 'h2' } = Astro.props;
const portrait = image.height > image.width * 0.9;
---

<section class:list={['section', tint ? 'bg-sky-50' : 'bg-white']}>
  <div class="container-x grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div class:list={['relative', reverse && 'lg:order-2']}>
      <div class="absolute -inset-3 -z-0 rotate-2 rounded-[2rem] bg-gradient-to-br from-sky-400/30 to-lime-500/30"></div>
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 760, 960]}
        sizes="(min-width: 1024px) 600px, 100vw"
        class:list={[
          'relative w-full rounded-[1.75rem] object-cover shadow-xl',
          portrait ? 'aspect-[4/5] max-h-[620px]' : 'aspect-[19/12]',
        ]}
      />
    </div>
    <div class:list={[reverse && 'lg:order-1']}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <H class="text-3xl sm:text-4xl">{heading}</H>
      <div class="prose-purix mt-6">
        {paragraphs.map((p) => <p set:html={p} />)}
        <slot />
      </div>
      {
        phone && (
          <a href={phone.href} class="btn-navy mt-3">
            <Icon name="phone" class="size-5" />
            Call Now: {phone.label}
          </a>
        )
      }
    </div>
  </div>
</section>
