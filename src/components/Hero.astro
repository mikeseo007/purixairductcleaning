---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import QuoteForm from './QuoteForm.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { mainLocation, type Location } from '../data/site';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  image: ImageMetadata;
  imageAlt: string;
  location?: Location;
  service?: string;
  breadcrumbs?: { name: string; path: string }[];
  points?: string[];
}

const {
  eyebrow,
  title,
  subtitle,
  image,
  imageAlt,
  location = mainLocation,
  service,
  breadcrumbs,
  points = ['Same-day service', 'Residential & commercial', 'Experienced technicians'],
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-navy-950">
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-35"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-900/40"></div>

  <div class="container-x grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-12 lg:gap-12 lg:py-24">
    <div class="lg:col-span-7">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} dark />}
      {eyebrow && <p class="eyebrow !text-lime-500">{eyebrow}</p>}
      <h1 class="text-4xl leading-[1.08] !text-white sm:text-5xl lg:text-6xl">{title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/80 sm:text-xl">{subtitle}</p>

      <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-3 text-white">
        {
          points.map((p) => (
            <li class="flex items-center gap-2 font-semibold">
              <Icon name="checkCircle" class="size-5 text-lime-500" />
              {p}
            </li>
          ))
        }
      </ul>

      <div class="mt-9 flex flex-wrap gap-3">
        <a href={location.phoneHref} class="btn-primary !px-7 !py-4 text-lg">
          <Icon name="phone" class="size-5" />
          Call {location.phone}
        </a>
        <a href="#quote" class="btn-outline !px-7 !py-4 text-lg">Get a Free Quote</a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <QuoteForm location={location} service={service} />
    </div>
  </div>
</section>
