---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import GoogleMap from './GoogleMap.astro';
import { regions, locationsByRegion, milesFromOffice, site } from '../data/site';

interface Props {
  title?: string;
  intro?: string;
  current?: string;
  service?: { name: string };
  showMap?: boolean;
  tint?: boolean;
}

const {
  title = 'Areas We Serve in South & Southwest Florida',
  intro = 'Based in Miami, Purix serves homes and businesses across Miami-Dade and Broward, with service extending to Palm Beach, Collier and Lee counties.',
  current,
  service,
  showMap = true,
  tint = false,
} = Astro.props;

const what = service ? service.name : 'Air duct & HVAC cleaning';
---

<section class:list={['section', tint ? 'bg-sky-50' : 'bg-white']}>
  <div class="container-x">
    <SectionHeading eyebrow="Service areas" title={title} intro={intro} center />

    <div class:list={['mt-12 grid gap-8', showMap && 'lg:grid-cols-12']}>
      {
        showMap && (
          <div class="flex flex-col gap-4 lg:col-span-5">
            <GoogleMap class="h-[340px] lg:h-auto lg:min-h-[420px] lg:flex-1" />
          </div>
        )
      }

      <div class:list={['space-y-8', showMap && 'lg:col-span-7']}>
        {
          regions.map((r) => (
            <div>
              <h3 class="flex items-center gap-3 text-sm font-bold tracking-wider text-navy-700 uppercase">
                {r.name}
                <span class="h-px flex-1 bg-slate-200" />
              </h3>
              <ul class:list={['mt-4 grid grid-cols-2 gap-3', showMap ? 'sm:grid-cols-3' : 'sm:grid-cols-3 lg:grid-cols-4']}>
                {locationsByRegion(r.id).map((loc) => {
                  const isCurrent = loc.slug === current;
                  const sub = r.id === 'beyond' ? loc.county : `${milesFromOffice(loc)} mi from our office`;
                  return (
                    <li>
                      <a
                        href={loc.path}
                        title={`${what} in ${loc.city}, FL`}
                        aria-current={isCurrent ? 'page' : undefined}
                        class:list={[
                          'group flex h-full items-start gap-3 rounded-2xl border p-3.5 shadow-sm transition hover:-translate-y-0.5 hover:border-sky-200 hover:shadow-md hover:shadow-navy-900/10',
                          isCurrent ? 'border-sky-300 bg-sky-50' : 'border-slate-100 bg-white',
                        ]}
                      >
                        <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-xl bg-sky-100 text-navy-700">
                          <Icon name="pin" class="size-4" />
                        </span>
                        <span class="min-w-0">
                          <span class="block leading-tight font-bold text-navy-900 group-hover:text-sky-500">{loc.city}</span>
                          <span class="mt-0.5 block text-xs font-medium text-muted">
                            {isCurrent ? 'You’re here' : sub}
                          </span>
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }

        <div class="flex flex-col gap-4 rounded-3xl bg-navy-900 p-5 text-white sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-bold">Not sure if we cover your area?</p>
            <a href={site.phoneHref} class="mt-1 inline-flex items-center gap-2 text-sm font-semibold text-lime-500 hover:text-white">
              <Icon name="phone" class="size-4" />
              Call {site.phone}
            </a>
          </div>
          <a href="/service-areas/" class="group inline-flex items-center gap-2 rounded-full bg-white/10 px-5 py-2.5 text-sm font-semibold ring-1 ring-white/20 transition hover:bg-white/20">
            All service areas & neighborhoods
            <Icon name="arrowRight" class="size-4 text-lime-500 transition group-hover:translate-x-1" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
