---
import Icon from './Icon.astro';
import GoogleMap from './GoogleMap.astro';
import { site, mainLocation, type Location } from '../data/site';

interface Props {
  location: Location;
}

const { location } = Astro.props;
const isMain = location.slug === mainLocation.slug;
const query = encodeURIComponent(`${location.city}, FL`);
---

<section class="section bg-white">
  <div class="container-x grid gap-10 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <p class="eyebrow">Service area</p>
      <h2 class="text-3xl sm:text-4xl">Where we work in {location.city}</h2>
      <p class="mt-4 text-lg text-muted">
        Air duct, AC ductwork and HVAC cleaning for homes, condos and businesses in {location.city} and surrounding {location.county} communities.
      </p>

      <a href={site.phoneHref} class="mt-8 flex items-center gap-4 rounded-2xl bg-sky-50 p-4 ring-1 ring-sky-100 transition hover:bg-sky-100">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-navy-700 text-white"><Icon name="phone" /></span>
        <span>
          <span class="block text-sm font-semibold text-muted">Call to schedule</span>
          <span class="block text-xl font-extrabold text-navy-900">{site.phone}</span>
        </span>
      </a>

      <div class="mt-8">
        <p class="font-bold text-navy-900">Neighborhoods we serve</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {location.neighborhoods.map((n) => <li class="rounded-full bg-sky-50 px-3 py-1.5 text-sm font-medium text-navy-800 ring-1 ring-sky-100">{n}</li>)}
        </ul>
      </div>
      {
        location.nearby.length > 0 && (
          <div class="mt-6">
            <p class="font-bold text-navy-900">Also nearby</p>
            <p class="mt-2 text-muted">{location.nearby.join(', ')}</p>
          </div>
        )
      }
    </div>

    <div class="lg:col-span-3">
      {
        isMain ? (
          <GoogleMap class="h-[380px] lg:h-full lg:min-h-[440px]" />
        ) : (
          <div class="h-full min-h-[380px] overflow-hidden rounded-3xl bg-sky-50 shadow-sm ring-1 ring-slate-100">
            <iframe
              title={`Map of ${location.city}, FL`}
              src={`https://www.google.com/maps?q=${query}&output=embed`}
              class="h-full min-h-[380px] w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            />
          </div>
        )
      }
    </div>
  </div>
</section>
