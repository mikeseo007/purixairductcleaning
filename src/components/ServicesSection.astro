---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { serviceGroups, servicesByGroup } from '../data/services';

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  city?: string;
  current?: string;
  bg?: 'white' | 'sky';
}

const {
  eyebrow = 'Our Services',
  title = 'Air Duct, AC Ductwork & HVAC Cleaning Services',
  intro = 'Our main focus is your air conditioning system: the ductwork that carries the air and the equipment that cools it. Dryer vent services are available too.',
  city,
  current,
  bg = 'white',
} = Astro.props;

const [duct, hvac, dryer] = serviceGroups.map((g) => ({ ...g, items: servicesByGroup(g.id) }));
const primary = [duct, hvac];
---

<section class:list={['section', bg === 'sky' ? 'bg-sky-50' : 'bg-white']}>
  <div class="container-x">
    <SectionHeading eyebrow={eyebrow} title={title} intro={intro} center />

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      {
        primary.map((g) => (
          <div class="flex flex-col overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm">
            <div class="relative aspect-[16/7] overflow-hidden bg-navy-950">
              <Image
                src={g.image}
                alt={g.imageAlt}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 600px, 100vw"
                class="h-full w-full object-cover opacity-70"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/30 to-transparent" />
              <div class="absolute inset-x-0 bottom-0 p-6">
                <h3 class="text-2xl !text-white">
                  <a href={g.hub} class="hover:text-lime-500">
                    {city ? `${g.name} in ${city}` : g.name}
                  </a>
                </h3>
              </div>
            </div>
            <p class="px-6 pt-5 leading-relaxed text-muted">{g.intro}</p>
            <ul class="grid flex-1 gap-1 p-4 sm:grid-cols-2">
              {g.items.map((s) => (
                <li>
                  <a
                    href={s.path}
                    aria-current={s.slug === current ? 'page' : undefined}
                    class:list={[
                      'group flex h-full gap-3 rounded-2xl p-3 transition hover:bg-sky-50',
                      s.slug === current && 'bg-sky-50 ring-1 ring-sky-200',
                    ]}
                  >
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-navy-700 text-white">
                      <Icon name={s.icon} class="size-5" />
                    </span>
                    <span>
                      <span class="flex items-center gap-1 font-bold text-navy-900 group-hover:text-sky-500">
                        {s.name}
                        <Icon name="chevronRight" class="size-4 opacity-0 transition group-hover:opacity-100" />
                      </span>
                      <span class="mt-0.5 block text-sm leading-snug text-muted">{s.card}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-8 grid items-center gap-6 rounded-3xl border border-slate-100 bg-white p-5 shadow-sm md:grid-cols-[180px_1fr]">
      <Image
        src={dryer.image}
        alt={dryer.imageAlt}
        widths={[360]}
        sizes="180px"
        class="hidden aspect-[4/3] w-full rounded-2xl object-cover md:block"
      />
      <div>
        <h3 class="text-xl">
          <a href={dryer.hub} class="hover:text-sky-500">
            {city ? `${dryer.name} in ${city}` : dryer.name}
          </a>
        </h3>
        <p class="mt-1 text-sm text-muted">{dryer.intro}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            dryer.items.map((s) => (
              <li>
                <a
                  href={s.path}
                  aria-current={s.slug === current ? 'page' : undefined}
                  class:list={[
                    'inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold transition hover:border-sky-300 hover:bg-sky-50',
                    s.slug === current ? 'border-sky-300 bg-sky-50 text-navy-800' : 'border-slate-200 text-navy-900',
                  ]}
                >
                  <Icon name={s.icon} class="size-4 text-sky-500" />
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-8 text-center">
      <a href="/our-services/" class="inline-flex items-center gap-1.5 font-bold text-navy-700 hover:text-sky-500">
        Compare all services <Icon name="arrowRight" class="size-4" />
      </a>
    </p>
  </div>
</section>
