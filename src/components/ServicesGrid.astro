---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { services } from '../data/services';

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  exclude?: string;
  city?: string;
}

const {
  eyebrow = 'Our Services',
  title = 'Air Duct, Dryer Vent & HVAC Cleaning',
  intro,
  exclude,
  city,
} = Astro.props;
const list = services.filter((s) => s.slug !== exclude);
---

<section class="section bg-white">
  <div class="container-x">
    <SectionHeading eyebrow={eyebrow} title={title} intro={intro} center />
    <div class="mt-12 flex flex-wrap justify-center gap-6">
      {
        list.map((s) => (
          <article class="group relative flex w-full flex-col sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl hover:shadow-navy-900/10">
            <div class="relative aspect-[530/330] overflow-hidden">
              <Image
                src={s.cardImage}
                alt={s.cardImageAlt}
                widths={[400, 530]}
                sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <span class="absolute bottom-0 left-6 flex size-14 translate-y-1/2 items-center justify-center rounded-2xl bg-navy-700 text-white shadow-lg">
                <Icon name={s.icon} class="size-7" />
              </span>
            </div>
            <div class="flex flex-1 flex-col p-6 pt-10">
              <h3 class="text-xl">
                <a href={s.path} class="after:absolute after:inset-0 hover:text-sky-500">
                  {city ? `${s.name} in ${city}` : s.name}
                </a>
              </h3>
              <p class="mt-3 flex-1 leading-relaxed text-muted">{s.card}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 font-bold text-navy-700 group-hover:text-sky-500">
                Learn more <Icon name="arrowRight" class="size-4" />
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>